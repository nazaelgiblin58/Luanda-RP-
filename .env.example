# PORT: Porta HTTP/WebSocket do servidor backend (padrão 3000)
PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FRONTEND_URL / ALLOWED_ORIGINS: Origens permitidas no CORS e WebSocket (ex.: https://luandarp.netlify.app)
FRONTEND_URL=""
ALLOWED_ORIGINS=""

# ADMIN_EMAIL: Email da conta com privilégios máximos (Admin God) validados no servidor.
ADMIN_EMAIL="nazaelgiblin58@gmail.com"

# AUTH_SECRET: Segredo HMAC para assinar sessões de jogadores (definir fixo em produção).
AUTH_SECRET=""

# LUANDA_DB_PATH: Caminho persistente em volume de disco para a base de dados do mundo.
LUANDA_DB_PATH=""

# SUPABASE (Frontend Público — nunca colocar secret key ou service_role com prefixo VITE_)
VITE_SUPABASE_URL="https://zoamzawcpoomqwmzvaxk.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_qxvjzioRhdOaa-lUUi3qcg_nNmCwLXS"

# SUPABASE (Apenas Servidor Node.js — nunca expor no frontend!)
SUPABASE_URL="https://zoamzawcpoomqwmzvaxk.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_qxvjzioRhdOaa-lUUi3qcg_nNmCwLXS"
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWKS_URL="https://zoamzawcpoomqwmzvaxk.supabase.co/auth/v1/.well-known/jwks.json"

# Frontend estático (Netlify) — apontar para o servidor backend Node/WebSocket:
VITE_API_BASE_URL=""
VITE_WS_URL=""
